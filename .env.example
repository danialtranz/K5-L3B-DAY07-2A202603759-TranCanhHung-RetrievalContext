# Copy to starter/.env or repo-root .env (never commit real keys)
OPENROUTER_API_KEY=
OPENAI_API_KEY=
CHAT_MODEL=gpt-4o-mini
# For reasoning models used with tools (e.g. gpt-6-luna), keep none:
REASONING_EFFORT=none

# Optional overrides (defaults point at starter/data copied from Day 6)
CHROMA_PATH=starter/data/chroma
SQLITE_PATH=starter/data/lab.db
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
